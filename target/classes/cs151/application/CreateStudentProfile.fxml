<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cs151.application.StudentProfilesController"
            prefWidth="1000" prefHeight="650"
            style="-fx-background-color: linear-gradient(to bottom, #f7f9fc, #e3f0ff);">

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;">
            <content>
                <!-- Main card -->
                <VBox spacing="18.0"
                      style="-fx-background-color: #ffffff;
                             -fx-background-radius: 24;
                             -fx-padding: 24 32 32 32;
                             -fx-effect: dropshadow(gaussian, rgba(15,76,129,0.16), 24, 0.2, 0, 8);">

                    <!-- Top bar: Home button + title -->
                    <HBox alignment="CENTER_LEFT" fillHeight="false">
                        <children>
                            <Button onAction="#onBackToHome"
                                    prefHeight="28" prefWidth="90"
                                    text="← Home"
                                    style="-fx-background-color: #ffffff;
                                           -fx-font-size: 12;
                                           -fx-background-radius: 999;
                                           -fx-border-color: #0f4c81;
                                           -fx-border-radius: 999;
                                           -fx-text-fill: #0f4c81;
                                           -fx-padding: 4 14 4 14;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Create Student Profile"
                                   style="-fx-text-fill: #0f4c81;">
                                <font>
                                    <Font size="26"/>
                                </font>
                            </Label>
                        </children>
                    </HBox>

                    <Separator/>

                    <padding>
                        <Insets topRightBottomLeft="12"/>
                    </padding>

                    <!-- ===== 2.1 Basic Information ===== -->
                    <Label text="Basic Information"
                           style="-fx-font-weight:bold;
                                  -fx-font-size:14px;
                                  -fx-text-fill:#0f4c81;"/>

                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <children>
                            <Label text="Full Name:"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0"
                                   style="-fx-text-fill:#444;"/>
                            <TextField fx:id="fullNameInput"
                                       promptText="e.g., Alice Lee"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-background-radius: 10;
                                              -fx-border-radius: 10;
                                              -fx-border-color: #d0d7e2;"/>

                            <Label text="Academic Status:"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0"
                                   style="-fx-text-fill:#444;"/>
                            <ChoiceBox fx:id="academicStatusChoice"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"
                                       style="-fx-background-radius: 10;
                                              -fx-border-radius: 10;
                                              -fx-border-color: #d0d7e2;"/>

                            <Label text="Current Job Status:"
                                   GridPane.rowIndex="2" GridPane.columnIndex="0"
                                   style="-fx-text-fill:#444;"/>
                            <HBox spacing="10"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <children>
                                    <RadioButton fx:id="employedYesRadio" text="Employed"/>
                                    <RadioButton fx:id="employedNoRadio" text="Not Employed"/>
                                </children>
                            </HBox>

                            <Label text="Job Details:"
                                   GridPane.rowIndex="3" GridPane.columnIndex="0"
                                   style="-fx-text-fill:#444;"/>
                            <TextField fx:id="jobDetailsInput"
                                       promptText="Company / Role / Hours..."
                                       GridPane.rowIndex="3" GridPane.columnIndex="1"
                                       style="-fx-background-radius: 10;
                                              -fx-border-radius: 10;
                                              -fx-border-color: #d0d7e2;"/>
                        </children>
                    </GridPane>

                    <!-- ===== 2.2 Skills and Interests ===== -->
                    <Label text="Skills and Interests"
                           style="-fx-font-weight:bold;
                                  -fx-font-size:14px;
                                  -fx-text-fill:#0f4c81;"/>

                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <children>
                            <Label text="Programming Languages Known:"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0"
                                   style="-fx-text-fill:#444;"/>
                            <ListView fx:id="languagesList"
                                      prefHeight="120"
                                      GridPane.rowIndex="0" GridPane.columnIndex="1"
                                      style="-fx-background-radius: 10;
                                             -fx-border-radius: 10;
                                             -fx-border-color: #d0d7e2;"/>

                            <Label text="Databases Known:"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0"
                                   style="-fx-text-fill:#444;"/>
                            <ListView fx:id="databasesList"
                                      prefHeight="120"
                                      GridPane.rowIndex="1" GridPane.columnIndex="1"
                                      style="-fx-background-radius: 10;
                                             -fx-border-radius: 10;
                                             -fx-border-color: #d0d7e2;"/>

                            <Label text="Preferred Professional Role:"
                                   GridPane.rowIndex="2" GridPane.columnIndex="0"
                                   style="-fx-text-fill:#444;"/>
                            <ChoiceBox fx:id="preferredRoleChoice"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"
                                       style="-fx-background-radius: 10;
                                              -fx-border-radius: 10;
                                              -fx-border-color: #d0d7e2;"/>
                        </children>
                    </GridPane>

                    <!-- ===== 2.4 Future Services Flags ===== -->
                    <Label text="Future Services Flags"
                           style="-fx-font-weight:bold;
                                  -fx-font-size:14px;
                                  -fx-text-fill:#0f4c81;"/>

                    <HBox spacing="16">
                        <children>
                            <CheckBox fx:id="whitelistCheck" text="Whitelist"/>
                            <CheckBox fx:id="blacklistCheck" text="Blacklist"/>
                        </children>
                    </HBox>

                    <!-- ===== Buttons ===== -->
                    <HBox spacing="12">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#onCancelForm"
                                prefHeight="36" prefWidth="80"
                                text="Cancel"
                                style="-fx-background-color: #ffffff;
                                       -fx-border-color: #d0d7e2;
                                       -fx-border-radius: 999;
                                       -fx-background-radius: 999;
                                       -fx-text-fill: #4c5563;"/>

                        <Button onAction="#onSubmitProfile"
                                prefHeight="36" prefWidth="110"
                                text="Submit"
                                style="-fx-background-color: #ff8a3d;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 999;
                                       -fx-border-radius: 999;"/>
                    </HBox>

                    <!-- Toggle: user must click to view the table -->
                    <HBox spacing="8">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="toggleProfilesBtn"
                                onAction="#onToggleProfiles"
                                prefHeight="32" prefWidth="140"
                                text="View All Profiles"
                                style="-fx-background-color: #ffffff;
                                       -fx-font-size: 12;
                                       -fx-background-radius: 999;
                                       -fx-border-color: #0f4c81;
                                       -fx-border-radius: 999;
                                       -fx-text-fill: #0f4c81;"/>
                    </HBox>

                    <Separator/>

                    <!-- ===== table area wrapped in a toggleable section ===== -->
                    <VBox fx:id="profilesSection" spacing="6">
                        <Label text="All Student Profiles"
                               style="-fx-font-weight:bold;
                                      -fx-text-fill:#0f4c81;"/>
                        <TableView fx:id="profilesTable" prefHeight="320"
                                   style="-fx-background-radius: 12;
                                          -fx-border-radius: 12;
                                          -fx-border-color: #d0d7e2;">
                            <columns>
                                <!-- 2.1 Basic -->
                                <TableColumn fx:id="nameCol"     text="Name"           prefWidth="180"/>
                                <TableColumn fx:id="statusCol"   text="Status"         prefWidth="110"/>
                                <TableColumn fx:id="employedCol" text="Employment"     prefWidth="110"/>
                                <TableColumn fx:id="jobCol"      text="Job Details"    prefWidth="200"/>

                                <!-- 2.2 Skills & Interests -->
                                <TableColumn fx:id="langsCol"    text="Languages"      prefWidth="220"/>
                                <TableColumn fx:id="dbsCol"      text="Databases"      prefWidth="200"/>
                                <TableColumn fx:id="roleCol"     text="Preferred Role" prefWidth="140"/>

                                <!-- 2.3 Faculty Evaluation -->
                                <TableColumn fx:id="commentsCol" text="Comments"       prefWidth="320"/>

                                <!-- 2.4 Flags -->
                                <TableColumn fx:id="wlCol"       text="Whitelist"      prefWidth="90"/>
                                <TableColumn fx:id="blCol"       text="Blacklist"      prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
