<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cs151.application.StudentDetailsController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom, #f7f9fc, #e3f0ff);">

    <!-- Header -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="24" bottom="8" left="24"/>
            </padding>

            <Label fx:id="titleLabel" text="Student Details" style="-fx-text-fill:#0f4c81;">
                <font><Font size="22"/></font>
            </Label>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="Close" onAction="#onClose"
                    style="-fx-background-color: #ffffff;
                           -fx-font-size: 12;
                           -fx-background-radius: 999;
                           -fx-border-color: #0f4c81;
                           -fx-border-radius: 999;
                           -fx-text-fill: #0f4c81;
                           -fx-padding: 4 16 4 16;"/>
        </HBox>
    </top>

    <!-- Content -->
    <center>
        <VBox alignment="TOP_CENTER">
            <padding>
                <Insets top="8" right="24" bottom="24" left="24"/>
            </padding>
            <children>
                <VBox spacing="12"
                      maxWidth="900"
                      style="-fx-background-color: #ffffff;
                             -fx-background-radius: 24;
                             -fx-padding: 20 24 24 24;
                             -fx-effect: dropshadow(gaussian, rgba(15,76,129,0.16), 24, 0.2, 0, 8);">

                    <!-- Top: read-only form -->
                    <TitledPane text="Profile" expanded="true">
                        <content>
                            <GridPane hgap="12" vgap="10">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>

                                <columnConstraints>
                                    <ColumnConstraints minWidth="140" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                    <ColumnConstraints minWidth="140" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <children>
                                    <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="fullName"
                                               GridPane.rowIndex="0" GridPane.columnIndex="1"
                                               editable="false"
                                               style="-fx-background-radius: 10;
                                                      -fx-border-radius: 10;
                                                      -fx-border-color: #d0d7e2;"/>

                                    <Label text="Academic Status:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <TextField fx:id="status"
                                               GridPane.rowIndex="0" GridPane.columnIndex="3"
                                               editable="false"
                                               style="-fx-background-radius: 10;
                                                      -fx-border-radius: 10;
                                                      -fx-border-color: #d0d7e2;"/>

                                    <Label text="Employed:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="employed"
                                               GridPane.rowIndex="1" GridPane.columnIndex="1"
                                               editable="false"
                                               style="-fx-background-radius: 10;
                                                      -fx-border-radius: 10;
                                                      -fx-border-color: #d0d7e2;"/>

                                    <Label text="Job Details:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                    <TextField fx:id="job"
                                               GridPane.rowIndex="1" GridPane.columnIndex="3"
                                               editable="false"
                                               style="-fx-background-radius: 10;
                                                      -fx-border-radius: 10;
                                                      -fx-border-color: #d0d7e2;"/>

                                    <Label text="Languages:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <TextArea fx:id="langs"
                                              GridPane.rowIndex="2" GridPane.columnIndex="1"
                                              editable="false" wrapText="true" prefRowCount="2"
                                              style="-fx-background-radius: 10;
                                                     -fx-border-radius: 10;
                                                     -fx-border-color: #d0d7e2;"/>

                                    <Label text="Databases:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                    <TextArea fx:id="dbs"
                                              GridPane.rowIndex="2" GridPane.columnIndex="3"
                                              editable="false" wrapText="true" prefRowCount="2"
                                              style="-fx-background-radius: 10;
                                                     -fx-border-radius: 10;
                                                     -fx-border-color: #d0d7e2;"/>

                                    <Label text="Preferred Role:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <TextField fx:id="role"
                                               GridPane.rowIndex="3" GridPane.columnIndex="1"
                                               editable="false"
                                               style="-fx-background-radius: 10;
                                                      -fx-border-radius: 10;
                                                      -fx-border-color: #d0d7e2;"/>

                                    <Label text="Flag:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                                    <TextField fx:id="flag"
                                               GridPane.rowIndex="3" GridPane.columnIndex="3"
                                               editable="false"
                                               style="-fx-background-radius: 10;
                                                      -fx-border-radius: 10;
                                                      -fx-border-color: #d0d7e2;"/>
                                </children>
                            </GridPane>
                        </content>
                    </TitledPane>

                    <!-- Bottom: comments table -->
                    <TitledPane text="Comments" expanded="true" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <TableView fx:id="commentsTable" VBox.vgrow="ALWAYS"
                                           style="-fx-background-radius: 12;
                                                  -fx-border-radius: 12;
                                                  -fx-border-color: #d0d7e2;">
                                    <columns>
                                        <TableColumn fx:id="dateCol" text="Date" prefWidth="180"/>
                                        <TableColumn fx:id="excerptCol" text="Comment (excerpt)" />
                                    </columns>
                                    <placeholder>
                                        <Label text="No comments yet."
                                               style="-fx-text-fill:#9aa5b5;"/>
                                    </placeholder>
                                </TableView>
                            </VBox>
                        </content>
                    </TitledPane>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
